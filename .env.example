# ==============================================================================
# HUGGING FACE SPACE SECRETS CONFIGURATION (.env.example)
# ==============================================================================
# In Hugging Face Spaces, secrets are configured as Space Secrets (Settings -> Secrets).
# To deploy them securely, configure them locally in your .env file.
# scripts/deploy.py will automatically resolve them, XOR-encrypt them, and push
# them to Hugging Face Space settings under the keys A, P, and PASS.
# ==============================================================================
`
# 1. Tailscale Authentication Key (TAILSCALE) -> Space Secret "A"
# Generate an ephemeral, reusable auth key at https://login.tailscale.com/admin/settings/keys
# Can be defined globally as TAILSCALE, or node-specifically as TAILSCALE_<suffix>
# (e.g., TAILSCALE_01="tskey-auth-..." for node server-01).
# ------------------------------------------------------------------------------
TAILSCALE="tskey-auth-k12345CNTRL-abcdefghijklmnopqrstuvwxyz"

# ------------------------------------------------------------------------------
# 2. Playit.gg Secret Token (PLAYIT) -> Space Secret "P"
# Secret agent credential token obtained from playit.gg dashboard.
# Can be defined globally as PLAYIT, or node-specifically as PLAYIT_<suffix>
# (e.g., PLAYIT_01="playit_token_here" for node server-01).
# ------------------------------------------------------------------------------
PLAYIT_01="playit_secret_token_node_01_here"
PLAYIT_02="playit_secret_token_node_02_here"

# ------------------------------------------------------------------------------
# 3. SSH User Password (SSH) -> Space Secret "PASS"
# Custom password for SSH login (user@hostname -p 2222 or via Minecraft tunnel).
# Can be defined globally as SSH, or node-specifically as SSH_<suffix>.
# If unset, orchestrator.py will dynamically generate a random 16-char password.
# ------------------------------------------------------------------------------
SSH="SuperSecureSSHPassword123!"

# ------------------------------------------------------------------------------
# 3b. Cloudflare Tunnel Token (CLOUDFLARE) -> Space Secret "CF"
# Enables the Cloudflare Tunnel service (no public IP required).
#
# NAMED TUNNEL (recommended — persistent public hostname):
#   1. Create a tunnel at https://one.dash.cloudflare.com/ -> Networks -> Tunnels
#   2. Copy the tunnel token shown during setup.
#   3. Configure the tunnel to point to http://localhost:7860 (Caddy).
#   CF="eyJhIjoiYWJjZGVmZ...your-cloudflare-tunnel-token-here"
#
# QUICK TUNNEL (no account needed — ephemeral *.trycloudflare.com URL):
#   Leave CF unset entirely. The service auto-creates a temporary public URL
#   and writes it to ~/.torch_metrics/cloudflare_url.txt on startup.
#
# Can be defined globally as CLOUDFLARE or node-specifically as CLOUDFLARE_<suffix>.
# The XOR-hardened value is uploaded to the Space Secret "CF".
# ------------------------------------------------------------------------------
CF="eyJhIjoiYWJjZGVmZ...your-cloudflare-tunnel-token-here"

# ------------------------------------------------------------------------------
# 4. Hugging Face Hub Deployment Tokens (HF1, HF2, ...)
# Used by scripts/deploy.py to push built code to configured nodes.yaml targets.
# Generate Write/Create tokens at https://huggingface.co/settings/tokens
# NOTE: Keys starting with "HF" are local and never uploaded to remote Spaces.
# ------------------------------------------------------------------------------
HF1="hf_YourPrimarySecretWriteTokenHere"
HF2="hf_YourSecondarySecretWriteTokenHere"

# ------------------------------------------------------------------------------
# 5. LiteLLM Dashboard Master Key (LITELLM_MASTER_KEY) -> Space Secret
# Enables the /litellm-ui/ dashboard on each backend node.
# Set to any secret string. Use this key to log in at:
#   https://<space>.hf.space/litellm-ui/
# If not set, the dashboard is disabled (proxy still works normally).
# ------------------------------------------------------------------------------
LITELLM_MASTER_KEY="sk-your-litellm-dashboard-key-here"

# ------------------------------------------------------------------------------
# 6. Docker Hub Configuration (DOCKER_USERNAME, DOCKER_PASSWORD, DOCKER_REPO)
# Used by scripts/push_docker.py to build and upload the camouflaged container.
# ------------------------------------------------------------------------------
DOCKER_USERNAME="your_dockerhub_username_here"
DOCKER_PASSWORD="your_dockerhub_access_token_or_password_here"
DOCKER_REPO="sanctuary"
DOCKER_TAG="latest"

