# llm_keys.yaml.example
#
# INSTRUCTIONS:
# 1. Copy this file to "llm_keys.yaml":
#    cp llm_keys.yaml.example llm_keys.yaml
#
# 2. Add your provider API keys. You can define multiple keys per provider.
#    LiteLLM will automatically balance requests across the key pool.
#
# 3. This file is git-ignored by default to prevent credential leakage.
# ------------------------------------------------------------------------------

providers:
  # --- 1. Wildcard / Pool Routing (Highly Recommended) ---
  # Any request for groq/some-model will match "groq/*" and rotate across these keys.
  groq:
    - "gsk_groqKeyOneHere"
    - "gsk_groqKeyTwoHere"
    - "gsk_groqKeyThreeHere"

  deepseek:
    - "sk-deepseekKeyOneHere"
    - "sk-deepseekKeyTwoHere"

  cerebras:
    - "csk-cerebrasKeyOneHere"

  gemini:
    - "AIzaSyGeminiKeyOneHere"
    - "AIzaSyGeminiKeyTwoHere"

  # --- 2. Model-Specific Targeting (Optional) ---
  # If you want to route a specific model to a dedicated API key pool,
  # or map a custom model name to a provider's model.
  #
  # Example:
  # openai:
  #   - "sk-standardWildcardKey..."
  #   - model: "gpt-4o"
  #     keys:
  #       - "sk-dedicatedGpt4Key..."

# --- LiteLLM Router Settings (Optional) ---
# Merged on top of hardcoded defaults. Omitted keys keep their defaults.
# Defaults: routing_strategy=usage-based-routing-v2, num_retries=3, retry_after=5
router_settings:
  routing_strategy: usage-based-routing-v2  # simple-shuffle | least-busy | latency-based-routing
  num_retries: 3
  retry_after: 5
  # allowed_fails: 3                        # failures before a key is cooled-down
  # cooldown_time: 60                       # seconds a failed key stays out of rotation

# --- LiteLLM Settings (Optional) ---
# Merged on top of defaults (check_provider_endpoint=true, drop_params=true).
litellm_settings:
  check_provider_endpoint: true
  drop_params: true
  # request_timeout: 120
