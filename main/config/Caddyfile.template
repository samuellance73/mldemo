{
    # Global options
    admin off                  # Disable admin API to avoid port conflicts
    auto_https off             # Disable automatic HTTPS (terminated by Hugging Face)
    log {
        output file {METRICS_DIR}/caddy.log
        format console
        level info
    }
}

# Bind to Hugging Face Spaces port {CADDY_PORT} and secondary port {CADDY_SECONDARY_PORT}
:{CADDY_PORT}, :{CADDY_SECONDARY_PORT} {
    # --- Static asset serving (served directly from disk, no Python involved) ---
    handle /static/* {
        root * {STATIC_DIR}
        file_server
    }

    # Chisel tunnel (strips prefix)
    handle_path /chisel-tunnel* {
        reverse_proxy {LOCALHOST}:{CHISEL_PORT}
    }

    # Gost bridge (retains prefix)
    handle /gost-bridge* {
        reverse_proxy {LOCALHOST}:{GOST_PORT}
    }

    # Model sync (strips prefix)
    handle_path /model-sync* {
        reverse_proxy {LOCALHOST}:{MODEL_SYNC_PORT}
    }

    # Tensor mesh / Sliver (removes cert validation for self-signed backend)
    handle /tensor-mesh* {
        reverse_proxy https://{LOCALHOST}:{SLIVER_PORT} {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }

    # LiteLLM OpenAI API proxy (retains prefix)
    handle /v1* {
        reverse_proxy {LOCALHOST}:{LLM_PROXY_PORT}
    }

    # LiteLLM health check (retains prefix)
    handle /health* {
        reverse_proxy {LOCALHOST}:{LLM_PROXY_PORT}
    }

    # Routing console / Filebrowser (retains prefix)
    handle /routing-console* {
        reverse_proxy {LOCALHOST}:{FILEBROWSER_PORT}
    }

    # Visual Debugger (retains prefix)
    handle /visual-debugger* {
        reverse_proxy {LOCALHOST}:{VISUAL_DEBUGGER_PORT}
    }

    # Default: route all other public traffic to Gradio (port {GRADIO_PORT})
    handle {
        reverse_proxy {LOCALHOST}:{GRADIO_PORT} {
            # Inform Gradio of the real scheme so it generates https:// asset URLs.
            header_up X-Forwarded-Proto https
        }
    }

    # --- Upstream error interception (served from disk, Python runtime unburdened) ---
    handle_errors {
        root * {STATIC_DIR}
        rewrite * /loading.html
        file_server
    }
}